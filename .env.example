# ---------------------------------------------------------------------------
# CMIMS environment configuration template.
#
# Copy this file to `.env` and fill in real values:
#     Windows (Command Prompt):  copy .env.example .env
#     Windows (PowerShell):      Copy-Item .env.example .env
#     macOS / Linux:             cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed.
# ---------------------------------------------------------------------------

# REQUIRED in production: a long random string used to sign session cookies.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: point the database somewhere other than instance/computer_maintenance.db
# DATABASE_URL=sqlite:////absolute/path/to/computer_maintenance.db

# Optional: where optional fault attachments are stored (defaults to
# instance/uploads).  Keep this outside any web-served directory.
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Set to true when the application is served over HTTPS so the session cookie
# is only ever sent over TLS.  Leave blank/false for local HTTP development.
# SESSION_COOKIE_SECURE=true

# Development server host/port (python app.py)
# HOST=127.0.0.1
# PORT=5000
